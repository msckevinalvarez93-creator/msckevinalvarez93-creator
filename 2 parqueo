import java.util.Scanner;

public class Parqueo {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        double totalRecaudado = 0;
        int cantMotos = 0, cantAutos = 0, cantCamiones = 0, cantBicis = 0;
        String placaMayor = "Ninguno";
        double mayorPago = -1;
        String respuesta;

        do {
            int tipo;
            do {
                System.out.println("Tipo: 1. Moto  2. Auto  3. Camión  4. Bicicleta");
                System.out.print("Elige tipo: ");
                tipo = sc.nextInt();
                sc.nextLine();
                if (tipo < 1 || tipo > 4) System.out.println("Tipo inválido, intenta de nuevo.");
            } while (tipo < 1 || tipo > 4);

            System.out.print("Placa: ");
            String placa = sc.nextLine();

            int minutos;
            do {
                System.out.print("Minutos estacionado: ");
                minutos = sc.nextInt();
                sc.nextLine();
                if (minutos <= 0) System.out.println("Los minutos deben ser mayores que 0.");
            } while (minutos <= 0);

            Vehiculo v;
            if (tipo == 1) { v = new Moto(placa, minutos); cantMotos++; }
            else if (tipo == 2) { v = new Auto(placa, minutos); cantAutos++; }
            else if (tipo == 3) { v = new Camion(placa, minutos); cantCamiones++; }
            else { v = new Bicicleta(placa, minutos); cantBicis++; }

            v.imprimirTicket();
            totalRecaudado += v.calcularCobro();

            // Bicicleta no cuenta para el que pagó más
            if (tipo != 4 && v.calcularCobro() > mayorPago) {
                mayorPago = v.calcularCobro();
                placaMayor = v.getPlaca();
            }

            System.out.print("¿Registrar otro vehículo? (s/n): ");
            respuesta = sc.nextLine();
        } while (respuesta.equalsIgnoreCase("s"));

        System.out.println("\n--- Reporte del día ---");
        System.out.println("Motos: " + cantMotos);
        System.out.println("Autos: " + cantAutos);
        System.out.println("Camiones: " + cantCamiones);
        System.out.println("Bicicletas: " + cantBicis);
        System.out.println("Total recaudado: C$" + totalRecaudado);
        System.out.println("Placa que pagó más: " + placaMayor + (mayorPago >= 0 ? " - C$" + mayorPago : ""));

        sc.close();
    }
}
