#Programa de consola para consultar productos, vender, reabastecer inventario, cambiar precios y consultar el reporte diario. Utiliza encapsulamiento.

#productos 
public class Producto {
    private String nombre;
    private double precio;
    private int stock;

    public Producto(String nombre, double precio, int stock) {
        this.nombre = nombre;
        this.precio = precio;
        this.stock = stock;
    }

    public String getNombre() { return nombre; }
    public double getPrecio() { return precio; }
    public int getStock() { return stock; }

    public void setPrecio(double nuevoPrecio) {
        if (nuevoPrecio > 0) {
            this.precio = nuevoPrecio;
        } else {
            System.out.println("Precio invalido. Debe ser mayor que 0.");
        }
    }

    public boolean vender(int cantidad) {
        if (cantidad <= 0 || cantidad > stock) {
            return false;
        }
        stock -= cantidad;
        return true;
    }

    public void reabastecer(int cantidad) {
        if (cantidad > 0) {
            stock += cantidad;
        } else {
            System.out.println("Cantidad invalida para reabastecer.");
        }
    }

    public static void main(String[] args) {
        Producto p = new Producto("Teclado", 25.50, 10);

        System.out.println("Producto: " + p.getNombre());
        System.out.println("Precio: " + p.getPrecio());
        System.out.println("Stock inicial: " + p.getStock());

        System.out.println("Venta de 3 unidades? " + p.vender(3));
        System.out.println("Stock tras vender: " + p.getStock());

        p.reabastecer(5);
        System.out.println("Stock tras reabastecer: " + p.getStock());

        p.setPrecio(-1);
        p.setPrecio(30.00);
        System.out.println("Precio final: " + p.getPrecio());
    }
}


