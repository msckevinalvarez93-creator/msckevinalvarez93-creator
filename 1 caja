public class Caja {
    private double totalVendido;
    private int numeroVentas;
    private int numeroOrden;

    public Caja() {
        totalVendido = 0;
        numeroVentas = 0;
        numeroOrden = 0;
    }

    public double getTotalVendido() { return totalVendido; }
    public int getNumeroVentas() { return numeroVentas; }

    private double redondear(double valor) {
        return Math.round(valor * 100) / 100.0;
    }

    // Versión que pide el PDF
    public boolean cobrar(Producto producto, int cantidad) {
        return cobrar(producto, cantidad, "Cliente");
    }

    // Versión con reto opcional: nombre + número de orden
    public boolean cobrar(Producto producto, int cantidad, String cliente) {
        if (!producto.vender(cantidad)) {
            System.out.println("No hay stock suficiente o cantidad inválida.");
            return false;
        }
        numeroOrden++;
        double subtotal = producto.getPrecio() * cantidad;
        double descuento = 0;
        if (subtotal >= 300) {
            descuento = subtotal * 0.10;
        }
        double base = subtotal - descuento;
        double iva = redondear(base * 0.15);
        double total = redondear(base + iva);

        System.out.println("----- TICKET -----");
        System.out.println("Orden #" + numeroOrden + " - Cliente: " + cliente);
        System.out.println(producto.getNombre() + " x " + cantidad);
        System.out.println("Subtotal:   C$" + subtotal);
        System.out.println("Descuento:  C$" + descuento);
        System.out.println("IVA (15%):  C$" + iva);
        System.out.println("TOTAL:      C$" + total);
        System.out.println("------------------");

        totalVendido += total;
        numeroVentas++;
        return true;
    }

    public void mostrarReporte() {
        System.out.println("--- Reporte del día ---");
        System.out.println("Número de ventas: " + numeroVentas);
        System.out.println("Total vendido: C$" + redondear(totalVendido));
    }
}
