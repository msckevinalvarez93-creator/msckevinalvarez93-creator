public class Camion extends Vehiculo {
    public Camion(String placa, int minutos) { super(placa, minutos); }
    @Override
    public double getTarifaPorHora() { return 35; }

    @Override
    public double calcularCobro() {
        double cobro = super.calcularCobro();
        if (calcularHoras() >= 1) {
            cobro += 50;
        }
        return cobro;
    }
}
